{
  "name": "code-companion",
  "displayName": "Code Companion",
  "description": "Code-aware AI assistant for debugging, understanding, and improving code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeCompanion",
          "title": "Code Companion",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "codeCompanion": [
        {
          "type": "webview",
          "id": "codeCompanion.chat",
          "name": "Code Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "codeCompanion.focus",
        "title": "Code Companion: Open Chat"
      },
      {
        "command": "codeCompanion.newSession",
        "title": "Code Companion: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "codeCompanion.showHistory",
        "title": "Code Companion: Chat History",
        "icon": "$(history)"
      },
      {
        "command": "codeCompanion.openInEditor",
        "title": "Code Companion: Open Chat in Editor",
        "icon": "$(link-external)"
      },
      {
        "command": "codeCompanion.addActiveFile",
        "title": "Code Companion: Add Active File to Context"
      },
      {
        "command": "codeCompanion.addFiles",
        "title": "Code Companion: Add Files to Context…"
      },
      {
        "command": "codeCompanion.login",
        "title": "Code Companion: Sign In"
      },
      {
        "command": "codeCompanion.logout",
        "title": "Code Companion: Sign Out"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeCompanion.newSession",
          "when": "view == codeCompanion.chat",
          "group": "navigation@1"
        },
        {
          "command": "codeCompanion.showHistory",
          "when": "view == codeCompanion.chat",
          "group": "navigation@2"
        },
        {
          "command": "codeCompanion.openInEditor",
          "when": "view == codeCompanion.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "codeCompanion.addActiveFile",
          "group": "codeCompanion"
        }
      ]
    },
    "configuration": {
      "title": "Code Companion",
      "properties": {
        "codeCompanion.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the Code Companion FastAPI backend."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.115.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^6.0.2"
  }
}
