# Code Companion — app config. LLM/model config lives in config.yaml.

DEBUG=false
CORS_ORIGINS=*

# Signs access tokens; use ≥32 bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
TOKEN_TTL_DAYS=30

# Async SQLAlchemy URL; defaults to a local SQLite file.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
