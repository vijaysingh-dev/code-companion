# Code Companion — backend config.

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
# Comma-separated, or leave as * for local dev.
CORS_ORIGINS=*

# ── Main LLM ─────────────────────────────────────────────────────────────────
# The model that reasons, plans, and edits code.
#
# LLM_PROVIDER must be one of: openai | anthropic | google | llama
#   (any other value fails at startup).
# LLM_MODEL   — leave blank to use the recommended model for the provider:
#   openai=gpt-4o  anthropic=claude-opus-4-8  google=gemini-2.5-pro  llama=llama-3.3-70b-instruct
# LLM_BASE_URL — optional; set for self-hosted / OpenAI-compatible endpoints
#   (llama via Ollama/Together/Groq; google via an OpenAI-compat proxy).
# LLM_TEMPERATURE — blank = don't send it (provider default). Anthropic's current
#   models reject temperature, so leave this blank when LLM_PROVIDER=anthropic.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=2048

# ── Per-provider quick reference ─────────────────────────────────────────────
# Copy one block up into the Main LLM section (fill the key):
#
#   # OpenAI
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#
#   # Anthropic (Claude) — leave LLM_TEMPERATURE blank
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#
#   # Google (Gemini)
#   LLM_PROVIDER=google
#   LLM_API_KEY=...
#   # LLM_BASE_URL=   # only if going through an OpenAI-compatible proxy
#
#   # Llama (self-hosted / hosted) — base_url is required
#   LLM_PROVIDER=llama
#   LLM_API_KEY=ollama          # or the host's key
#   LLM_BASE_URL=http://localhost:11434/v1

# ── Small LLM ────────────────────────────────────────────────────────────────
# The cheap/fast model for grunt steps: search, summarize, classify.
# Defaults to the main provider; its key/endpoint reuse the main LLM_* only when it
# runs on that SAME provider — a different provider needs its own key (and base_url).
# The model and generation params are always its own (blank model = provider default:
#   openai=gpt-4o-mini  anthropic=claude-haiku-4-5  google=gemini-2.5-flash  llama=llama-3.1-8b-instruct).
MINI_LLM_MODEL=
MINI_LLM_TEMPERATURE=
MINI_LLM_MAX_TOKENS=1024
# Uncomment to run the mini tier on a different provider/account than the main one:
# MINI_LLM_PROVIDER=google
# MINI_LLM_API_KEY=
# MINI_LLM_BASE_URL=
