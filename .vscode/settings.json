// Workspace settings for the FastAPI backend (repo root).
// Extension-specific editor settings live in extension/.vscode/settings.json.
{
  "editor.formatOnSave": true,
  "editor.rulers": [120],

  "ruff.lineLength": 120,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }
}
